# =============================================================================
#  .gitattributes — force LF line endings for everything that runs on Linux
# =============================================================================
#  Aegis OS is built and booted on Linux. CRLF in a shell script breaks its
#  shebang ("bad interpreter: /bin/bash^M") and CRLF in build-iso.sh breaks the
#  CI build. Normalize all text to LF in the repository, regardless of the
#  contributor's core.autocrlf setting or OS.
# =============================================================================

# Default: detect text vs binary; store text as LF and check it out as LF.
* text=auto eol=lf

# Belt-and-suspenders: force these to be treated as LF text even if content
# auto-detection is ever unsure.
*.sh              text eol=lf
*.bash            text eol=lf
*.zsh             text eol=lf
*.conf            text eol=lf
*.toml            text eol=lf
*.xml             text eol=lf
*.qml             text eol=lf
*.desc            text eol=lf
*.service         text eol=lf
*.desktop         text eol=lf
*.md              text eol=lf
*.svg             text eol=lf
*.x86_64          text eol=lf
PKGBUILD          text eol=lf
profiledef.sh     text eol=lf

# Executable helper scripts that have no file extension.
profile/airootfs/usr/local/bin/*  text eol=lf

# Explicit binaries (none today, but keep future images from being mangled).
*.png   binary
*.jpg   binary
*.ico   binary
*.gz    binary
*.zst   binary
