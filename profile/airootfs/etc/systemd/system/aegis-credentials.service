[Unit]
Description=Aegis OS live credentials (user, passwords, sudo)
Documentation=https://aegis-os.example/docs
# systemd-sysusers has to have created the base accounts before we touch shadow.
After=local-fs.target systemd-sysusers.service
# Everything that needs to authenticate must wait for this: the greeter, the
# ttys, and aegis-live-setup (which assumes the live user already exists).
Before=aegis-live-setup.service display-manager.service systemd-user-sessions.service getty.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Short, hard cap. This script does no network I/O, no locale-gen and no
# `systemctl start`, so it has nothing legitimate to block on. If it is not done
# in 45s something is badly wrong, and boot should continue to a usable greeter
# rather than freeze the way the guest-agent hang used to.
TimeoutStartSec=45
ExecStart=/usr/local/bin/aegis-credentials
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
