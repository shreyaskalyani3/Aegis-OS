[Unit]
Description=Aegis OS live environment setup (user, autologin, locale)
Documentation=https://aegis-os.example/docs
After=local-fs.target systemd-tmpfiles-setup.service aegis-credentials.service
Before=display-manager.service systemd-user-sessions.service getty.target
Wants=local-fs.target
# Pull credentials in explicitly. Ordering alone is not enough: if the want-link
# for aegis-credentials.service were ever missing, this unit would otherwise run
# first and configure a desktop that has no account to log into.
Wants=aegis-credentials.service

[Service]
Type=oneshot
RemainAfterExit=yes
# oneshot disables the start timeout by default (TimeoutStartSec=infinity), which
# means any hang inside the script blocks boot forever. Cap it so boot always
# recovers instead of freezing on "A start job is running ... / no limit".
TimeoutStartSec=120
ExecStart=/usr/local/bin/aegis-live-setup
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
