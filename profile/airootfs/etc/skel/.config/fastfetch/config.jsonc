// =============================================================================
//  Aegis OS — fastfetch config (/etc/skel/.config/fastfetch/config.jsonc)
// =============================================================================
//  The terminal's system-info screen: the ANSI-colored Aegis shield
//  (/usr/share/aegis/fastfetch-logo.txt) beside a grouped spec sheet —
//  system, desktop, hardware, network. Keys are bold grey, values plain;
//  section rules are dim. Shipped via /etc/skel so every user gets it.
// =============================================================================
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/aegis/fastfetch-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": " ",
    "key": { "width": 11 },
    "color": {
      "keys": "1;38;2;139;148;158",
      "title": "1;38;2;255;255;255",
      "output": "38;2;208;215;222"
    }
  },
  "modules": [
    "break",
    "title",
    {
      "type": "custom",
      "format": "{#keys}─────────────────────────────"
    },
    { "type": "os",       "key": "OS" },
    { "type": "host",     "key": "Host" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    "break",
    {
      "type": "custom",
      "format": "{#keys}desktop ─────────────────────"
    },
    { "type": "de",          "key": "DE" },
    { "type": "wm",          "key": "WM" },
    { "type": "wmtheme",     "key": "WM Theme" },
    { "type": "terminal",    "key": "Terminal" },
    { "type": "terminalfont","key": "Term Font" },
    { "type": "theme",       "key": "Theme" },
    { "type": "icons",       "key": "Icons" },
    { "type": "font",        "key": "Font" },
    "break",
    {
      "type": "custom",
      "format": "{#keys}hardware ────────────────────"
    },
    { "type": "cpu",    "key": "CPU" },
    { "type": "gpu",    "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap",   "key": "Swap" },
    { "type": "disk",   "key": "Disk" },
    "break",
    {
      "type": "custom",
      "format": "{#keys}network ──────────────────────"
    },
    { "type": "localip", "key": "Local IP" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
