[Unit]
Description=Aegis OS first graphical-login setup
After=graphical-session.target aegis-wallpaper.service
Wants=aegis-wallpaper.service
PartOf=graphical-session.target aegis-session.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/aegis-desktop-setup
ExecStart=/usr/local/bin/aegis-welcome
Restart=no

[Install]
WantedBy=aegis-session.target
