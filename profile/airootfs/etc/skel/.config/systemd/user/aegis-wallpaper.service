[Unit]
Description=Aegis wallpaper daemon
After=graphical-session.target
PartOf=graphical-session.target aegis-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=/usr/bin/awww-daemon
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/bin/awww-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=aegis-session.target
