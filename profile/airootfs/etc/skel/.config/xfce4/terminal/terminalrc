[Configuration]
# xfce4-terminal — Aegis OS palette. Matches the MOTD banner / zsh prompt
# colours in .zshrc and aegis-motd so the terminal reads as one piece with the
# rest of the branding.
#
# This palette is duplicated in ~/.config/alacritty/alacritty.toml. The two
# terminals are expected to look identical; edit both, or neither.
FontName=JetBrainsMono Nerd Font 11
FontUseSystem=FALSE
MiscAlwaysShowTabs=FALSE
MiscBell=FALSE
MiscBellUrgent=FALSE
MiscBordersDefault=TRUE
MiscCursorBlinks=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscDefaultGeometry=100x30
MiscInheritGeometry=FALSE
# Hidden by default: the menu bar only costs vertical space in a terminal whose
# toolbar is already off. Ctrl+Shift+M (or right-click -> Show Menubar) brings
# it back for the session.
MiscMenubarDefault=FALSE
MiscMouseAutohide=FALSE
MiscMouseWheelZoom=TRUE
MiscToolbarDefault=FALSE
MiscConfirmClose=TRUE
MiscCycleTabs=TRUE
MiscTabCloseButtons=TRUE
MiscTabCloseMiddleClick=TRUE
MiscTabPosition=GTK_POS_TOP
MiscHighlightUrls=TRUE
MiscMiddleClickOpensUri=FALSE
MiscCopyOnSelect=FALSE
MiscShowRelaunchDialog=TRUE
MiscRewrapOnResize=TRUE
MiscUseShiftArrowsToScroll=FALSE
MiscSlimTabs=FALSE
MiscNewTabAdjacent=FALSE
MiscSearchDialogOpacity=100
MiscShowUnsafePasteDialog=TRUE
ScrollingUnlimited=TRUE
ScrollingBar=TERMINAL_SCROLLBAR_RIGHT
ScrollingOnOutput=FALSE
ScrollingOnKeystroke=TRUE
BackgroundMode=TERMINAL_BACKGROUND_TRANSPARENT
BackgroundDarkness=0.960000
ColorForeground=#cdd5df
ColorBackground=#0b0f17
ColorCursor=#ff2e4d
ColorCursorForeground=#0b0f17
ColorCursorUseDefault=FALSE
# Selection: ColorSelection is the text, ColorSelectionBackground is the block
# behind it. Both were #264f78, which painted dark blue on dark blue — selected
# text was invisible. They must differ.
ColorSelection=#eef3f8
ColorSelectionBackground=#2f3c52
ColorSelectionUseDefault=FALSE
# Bold keeps its own colour and is brightened by the palette below; pinning
# ColorBold to a single value would paint every bold run (the whole MOTD
# banner) in that one colour.
ColorBoldUseDefault=TRUE
ColorBoldIsBright=TRUE
ColorPalette=#151a24;#ff3556;#2fca7e;#e5a94a;#4fa7ff;#b98cff;#3fc6d6;#b6bfcb;#4a5263;#ff6477;#5ee0a0;#f0c06e;#78c0ff;#d0a8ff;#6fd6e4;#eef3f8
TitleMode=TERMINAL_TITLE_REPLACE
