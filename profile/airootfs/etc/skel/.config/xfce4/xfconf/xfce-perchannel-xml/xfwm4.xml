<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <!-- Dark window decorations to match adw-gtk3-dark from xsettings.xml.
         "Default-hdpi"/"Default" are the stock light themes; Daloa is the dark
         variant shipped with xfwm4 itself, so this needs no extra package. -->
    <property name="theme" type="string" value="Daloa"/>
    <property name="title_font" type="string" value="Noto Sans Bold 10"/>
    <property name="button_layout" type="string" value="O|HMC"/>
    <property name="use_compositing" type="bool" value="true"/>
    <property name="frame_opacity" type="int" value="100"/>
    <property name="show_frame_shadow" type="bool" value="true"/>
    <property name="workspace_count" type="int" value="2"/>
    <property name="click_to_focus" type="bool" value="true"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="wrap_workspaces" type="bool" value="false"/>
  </property>
</channel>
