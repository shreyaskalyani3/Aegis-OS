[Desktop Entry]
Type=Application
Name=PolicyKit Authentication Agent
Comment=Grants graphical privilege-escalation prompts (needed by the installer)
Exec=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Icon=dialog-password
Terminal=false
Categories=System;
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
NoDisplay=true
