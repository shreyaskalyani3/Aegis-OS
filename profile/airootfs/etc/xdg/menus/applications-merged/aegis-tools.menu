<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN"
 "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<!--
  Aegis Tools — the categorised security menu for KDE Plasma (XDG standard).

  This is a MERGE FRAGMENT placed in /etc/xdg/menus/applications-merged/.
  KDE Plasma's Kickoff / Application Menu reads applications.menu, which
  expands <DefaultMergeDirs/> to applications-merged/.

  <Name>Applications</Name> matches the standard root menu name.
-->
<Menu>
  <Name>Applications</Name>

  <Menu>
    <Name>Aegis Tools</Name>
    <Directory>aegis-00-tools.directory</Directory>

    <Menu>
      <Name>01 Information Gathering</Name>
      <Directory>aegis-01-recon.directory</Directory>
      <Include><Category>X-Aegis-Recon</Category></Include>
    </Menu>

    <Menu>
      <Name>02 Vulnerability Analysis</Name>
      <Directory>aegis-02-vuln.directory</Directory>
      <Include><Category>X-Aegis-Vuln</Category></Include>
    </Menu>

    <Menu>
      <Name>03 Web Application</Name>
      <Directory>aegis-03-web.directory</Directory>
      <Include><Category>X-Aegis-Web</Category></Include>
    </Menu>

    <Menu>
      <Name>04 Password Attacks</Name>
      <Directory>aegis-04-passwords.directory</Directory>
      <Include><Category>X-Aegis-Passwords</Category></Include>
    </Menu>

    <Menu>
      <Name>05 Wireless</Name>
      <Directory>aegis-05-wireless.directory</Directory>
      <Include><Category>X-Aegis-Wireless</Category></Include>
    </Menu>

    <Menu>
      <Name>06 Exploitation</Name>
      <Directory>aegis-06-exploit.directory</Directory>
      <Include><Category>X-Aegis-Exploit</Category></Include>
    </Menu>

    <Menu>
      <Name>07 Sniffing and MITM</Name>
      <Directory>aegis-07-sniffing.directory</Directory>
      <Include><Category>X-Aegis-Sniffing</Category></Include>
    </Menu>

    <Menu>
      <Name>08 Forensics</Name>
      <Directory>aegis-08-forensics.directory</Directory>
      <Include><Category>X-Aegis-Forensics</Category></Include>
    </Menu>

    <Menu>
      <Name>09 Reverse Engineering</Name>
      <Directory>aegis-09-reversing.directory</Directory>
      <Include><Category>X-Aegis-Reversing</Category></Include>
    </Menu>

    <Menu>
      <Name>10 Anonymity and Maintenance</Name>
      <Directory>aegis-10-maintenance.directory</Directory>
      <Include><Category>X-Aegis-Maintenance</Category></Include>
    </Menu>

  </Menu>
</Menu>
