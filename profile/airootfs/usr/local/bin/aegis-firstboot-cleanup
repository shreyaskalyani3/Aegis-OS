#!/usr/bin/env bash
# =============================================================================
#  aegis-firstboot-cleanup — non-destructive first installed-boot notice.
#  Keep the existing unit/marker names for compatibility, but never erase
#  attached media. A volume label cannot prove which disk installed this OS,
#  and even the actual installer USB may be intentionally retained for rescue.
# =============================================================================
set -uo pipefail

MARKER="/var/lib/aegis/firstboot-cleanup-done"
[[ -f "${MARKER}" ]] && exit 0

log(){ printf 'aegis-firstboot-cleanup: %s\n' "$*"; }

# Check if this is a live/installer system.
if [[ -d /run/archiso ]]; then
    log "still running from live medium — skipping cleanup (install not yet complete?)"
    exit 0
fi

log "installed system booted; installer media and other attached disks are unchanged"
log "remove the installer USB/eject the VM ISO or choose the installed disk in the firmware boot menu"
if ! mkdir -p "$(dirname "${MARKER}")" || ! date > "${MARKER}"; then
    log "could not record completion; the notice may appear again"
fi
exit 0
