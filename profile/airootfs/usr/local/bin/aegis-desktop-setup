#!/usr/bin/env bash
# =============================================================================
#  aegis-desktop-setup — desktop configuration pass for KDE Plasma.
# =============================================================================
set -uo pipefail

log(){ printf 'aegis-desktop-setup: %s\n' "$*" >&2; }

WALL="/usr/share/backgrounds/aegis/aegis-wallpaper.svg"

# 1. Ensure Aphotic theme default is applied
if command -v aphotic >/dev/null 2>&1; then
    aphotic theme ensure-default 2>/dev/null || true
fi

# 2. Ensure Qt dark theme configuration
if command -v kwriteconfig6 >/dev/null 2>&1; then
    kwriteconfig6 --file kdeglobals --group Icons --key Theme Papirus-Dark 2>/dev/null || true
    kwriteconfig6 --file kdeglobals --group KDE --key widgetStyle Breeze 2>/dev/null || true
fi

# 4. On installed system, remove live installer launcher from desktop
if [[ ! -d /run/archiso ]]; then
    rm -f "${HOME:-}/Desktop/aegis-install.desktop" 2>/dev/null || true
fi

exit 0
