#!/usr/bin/env bash
# =============================================================================
#  aegis-desktop-setup — desktop configuration pass for Hyprland + Aphotic.
# =============================================================================
set -uo pipefail

log(){ printf 'aegis-desktop-setup: %s\n' "$*" >&2; }

WALL="/usr/share/backgrounds/aegis/aegis-wallpaper.svg"

# 1. Ensure Aphotic theme default is applied
if command -v aphotic >/dev/null 2>&1; then
    aphotic theme ensure-default 2>/dev/null || true
fi

# 2. Keep GTK applications dark in the Wayland session. Qt is configured by
# qt6ct through /etc/environment and the Hyprland session environment.
if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
fi

# 4. On installed system, remove live installer launcher from desktop
if [[ ! -d /run/archiso ]]; then
    rm -f "${HOME:-}/Desktop/aegis-install.desktop" 2>/dev/null || true
fi

exit 0
