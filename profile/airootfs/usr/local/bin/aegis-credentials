#!/usr/bin/env bash
# =============================================================================
#  aegis-credentials — create the live user and set the live passwords.
#
#  This is the ONLY thing in the image that produces a usable password. The
#  pacstrapped /etc/shadow ships root locked, and the profile overlay contains
#  no shadow/passwd/PAM files at all, so if this does not finish then nothing
#  can log in, sudo is unusable, and `pkexec calamares` behind the Install icon
#  is denied. It therefore lives in its own tiny unit, deliberately split out of
#  aegis-live-setup, which is best-effort and much more likely to fail or stall.
#
#  Rules this script follows, all of them load-bearing:
#    * no `set -e` — a cosmetic failure must never skip the passwords
#    * no network, no locale-gen, no `systemctl start` — nothing to wait on, so
#      it cannot burn its start timeout and get killed before setting a password
#    * authentication first; every optional step happens after
#    * every result is verified against /etc/shadow and logged, so a failure is
#      visible in `journalctl -u aegis-credentials` instead of silent
#
#  Credentials come from /etc/aegis/credentials.conf, which scripts/build-iso.sh
#  regenerates from aegis.conf at build time. The fallbacks below are real usable
#  values, so this script still works if that file is missing entirely.
# =============================================================================
set -uo pipefail

# Only ever touch the live session. Guarded first so an installed system that
# somehow still has the unit enabled is left completely alone.
[[ -d /run/archiso ]] || exit 0

LIVE_USER="aegis"
LIVE_PASS="aegis"
ROOT_PASS="aegis"
LIVE_SHELL="/usr/bin/zsh"

# Values are shell-quoted literals (printf %q), so sourcing round-trips any
# password safely — no sed-replacement escaping to get wrong.
CRED_CONF="/etc/aegis/credentials.conf"
if [[ -r "${CRED_CONF}" ]]; then
    # shellcheck source=/dev/null
    source "${CRED_CONF}" 2>/dev/null || echo "!! could not parse ${CRED_CONF}; using defaults" >&2
    LIVE_USER="${AEGIS_LIVE_USER:-${LIVE_USER}}"
    LIVE_PASS="${AEGIS_LIVE_PASSWORD:-${LIVE_PASS}}"
    ROOT_PASS="${AEGIS_ROOT_PASSWORD:-${ROOT_PASS}}"
    LIVE_SHELL="${AEGIS_DEFAULT_SHELL:-${LIVE_SHELL}}"
fi

have(){ command -v "$1" >/dev/null 2>&1; }
say(){ printf ':: %s\n' "$*"; }
err(){ printf '!! %s\n' "$*" >&2; }

echo ":: Aegis OS credentials: configuring live authentication"

# --- Live user ---------------------------------------------------------------
# -m is required: it copies /etc/skel, which is where the entire Aegis desktop
# identity (panel, wallpaper, terminal theme, Desktop/ icons) lives. Never
# pre-create this user in the SquashFS or skel is silently skipped.
[[ -x "${LIVE_SHELL}" ]] || { err "shell ${LIVE_SHELL} missing, falling back to /bin/bash"; LIVE_SHELL="/bin/bash"; }

if ! id -u "${LIVE_USER}" >/dev/null 2>&1; then
    useradd -m -s "${LIVE_SHELL}" -c "Aegis OS live user" "${LIVE_USER}" 2>/dev/null \
        || useradd -m "${LIVE_USER}" 2>/dev/null \
        || err "could not create user ${LIVE_USER}"
    id -u "${LIVE_USER}" >/dev/null 2>&1 && say "created user ${LIVE_USER} (shell ${LIVE_SHELL})"
fi

# --- Passwords ---------------------------------------------------------------
# A password only counts as set if /etc/shadow holds a real hash: a locked ("!",
# "!!", "!<hash>") or disabled ("*") field means login still fails, and chpasswd
# can leave one behind without a non-zero exit.
verify_pass() {  # $1 = account
    local h
    h="$(getent shadow "$1" 2>/dev/null | cut -d: -f2)"
    case "${h}" in
        ''|'*'|'!'*) return 1 ;;
        *)           [[ ${#h} -ge 13 ]] ;;
    esac
}

# chpasswd honours ENCRYPT_METHOD from /etc/login.defs and is the correct path.
# The openssl fallback exists because a single unsupported hash method would
# otherwise leave the whole image unloggable.
set_pass() {  # $1 = account, $2 = plaintext
    local acct="$1" pass="$2" hash
    printf '%s:%s\n' "${acct}" "${pass}" | chpasswd 2>/dev/null
    verify_pass "${acct}" && return 0
    err "chpasswd did not take for ${acct}; trying an explicit SHA-512 hash"
    if have openssl; then
        hash="$(openssl passwd -6 "${pass}" 2>/dev/null)"
        if [[ -n "${hash}" ]]; then
            usermod -p "${hash}" "${acct}" 2>/dev/null
            verify_pass "${acct}" && return 0
        fi
    fi
    return 1
}

rc=0
for acct in "${LIVE_USER}" root; do
    if [[ "${acct}" == root ]]; then pass="${ROOT_PASS}"; else pass="${LIVE_PASS}"; fi
    if set_pass "${acct}" "${pass}"; then
        say "password set for ${acct}"
    else
        err "FAILED to set a usable password for ${acct}"
        rc=1
    fi
done

# --- Auth-critical group membership ------------------------------------------
# wheel is not optional: it grants sudo via /etc/sudoers.d/10-aegis and it is
# polkit's default administrator identity, which is what `pkexec calamares`
# checks when the Install Aegis OS icon is used. autologin is LightDM's gate.
# The wider hardware-group list stays in aegis-live-setup, where failing is fine.
getent group autologin >/dev/null 2>&1 || groupadd -r autologin 2>/dev/null
for g in wheel autologin; do
    if getent group "${g}" >/dev/null 2>&1; then
        usermod -aG "${g}" "${LIVE_USER}" 2>/dev/null || err "could not add ${LIVE_USER} to ${g}"
    else
        err "group ${g} does not exist"
    fi
done

# --- Passwordless sudo for the live session ----------------------------------
# Written into the live overlay, never the SquashFS, so it cannot follow an
# install to disk (Calamares also removes it explicitly in shellprocess.conf).
install -d -m 0750 /etc/sudoers.d 2>/dev/null
# Remove first: the file is left mode 0440, so a re-run (aegis-live-setup calls
# this script as a safety net) would otherwise fail to truncate it.
rm -f /etc/sudoers.d/99-aegis-live 2>/dev/null
if printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "${LIVE_USER}" > /etc/sudoers.d/99-aegis-live 2>/dev/null; then
    chmod 0440 /etc/sudoers.d/99-aegis-live 2>/dev/null
    # A malformed sudoers file disables sudo entirely, so validate and drop it
    # rather than ship a broken one.
    if have visudo && ! visudo -cqf /etc/sudoers.d/99-aegis-live 2>/dev/null; then
        err "99-aegis-live failed validation; removing it (sudo will prompt for a password)"
        rm -f /etc/sudoers.d/99-aegis-live
    else
        say "passwordless sudo enabled for ${LIVE_USER}"
    fi
else
    err "could not write /etc/sudoers.d/99-aegis-live"
fi

if [[ ${rc} -eq 0 ]]; then
    # The password itself is deliberately not printed: on a customised build it
    # comes from AEGIS_LIVE_PASSWORD in aegis.conf and must not reach the
    # console or the journal.
    echo ":: Aegis OS credentials ready — live user: ${LIVE_USER}"
else
    err "Aegis OS credentials INCOMPLETE — see the errors above"
fi

# Always succeed: the unit is ordered before the display manager, and a non-zero
# exit here would only add a failed-unit delay on top of a problem this script
# has already reported and cannot fix.
exit 0
