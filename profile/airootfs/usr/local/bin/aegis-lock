#!/usr/bin/env bash
# =============================================================================
#  aegis-lock — the screen lock dispatcher on Aegis OS.
#
#  Engages the KDE Plasma session lockscreen via loginctl or D-Bus ScreenSaver,
#  falling back to display manager lock or screen blanking if necessary.
#
#  Order:
#    1. loginctl lock-session
#    2. qdbus / qdbus6 org.freedesktop.ScreenSaver /ScreenSaver Lock
#    3. dm-tool lock                       (greeter fallback)
#    4. xset s activate                    (blank screen, last resort)
#
#  Unlocking uses the live password (aegis / aegis) or the installed user's
#  password — PAM verified, never bypassed.
# =============================================================================
set -uo pipefail

log(){ printf 'aegis-lock: %s\n' "$*" >&2; }

# 1. KDE Plasma native session lock via loginctl or D-Bus ScreenSaver.
if command -v loginctl >/dev/null 2>&1 && loginctl lock-session 2>/dev/null; then
    exit 0
fi

if command -v qdbus >/dev/null 2>&1 && qdbus org.freedesktop.ScreenSaver /ScreenSaver Lock 2>/dev/null; then
    exit 0
fi

if command -v qdbus6 >/dev/null 2>&1 && qdbus6 org.freedesktop.ScreenSaver /ScreenSaver Lock 2>/dev/null; then
    exit 0
fi

# 2. Display manager locker fallback.
if command -v dm-tool >/dev/null 2>&1 && dm-tool lock 2>/dev/null; then
    exit 0
fi

# 3. Nothing else available — blank the screen rather than do nothing.
if command -v xset >/dev/null 2>&1; then
    xset s activate 2>/dev/null || true
    log "no locker found; blanked the screen via xset (this is NOT locked)"
    exit 0
fi

log "no locker found — nothing I can do to lock"
exit 1
