#!/usr/bin/env bash
# =============================================================================
#  aegis-live-setup — prepares the LIVE session (runs once at boot as root).
#  No-op on installed systems (guarded by the presence of /run/archiso).
# =============================================================================
set -euo pipefail

# Only run inside the live ISO environment.
[[ -d /run/archiso ]] || exit 0

LIVE_USER="aegis"
LIVE_PASS="aegis"
ROOT_PASS="aegis"
LIVE_SHELL="/usr/bin/zsh"

echo ":: Aegis OS live setup starting"

# --- Locale ------------------------------------------------------------------
if ! locale -a 2>/dev/null | grep -qiE 'en_US\.utf'; then
    grep -q '^en_US.UTF-8 UTF-8' /etc/locale.gen 2>/dev/null || echo 'en_US.UTF-8 UTF-8' >> /etc/locale.gen
    locale-gen || true
fi

# --- Groups ------------------------------------------------------------------
getent group autologin >/dev/null 2>&1 || groupadd -r autologin

# --- Live user ---------------------------------------------------------------
if ! id -u "${LIVE_USER}" >/dev/null 2>&1; then
    useradd -m -s "${LIVE_SHELL}" "${LIVE_USER}"
    echo "   created user ${LIVE_USER}"
fi

# Add to every relevant group that actually exists on the system.
want_groups=(wheel autologin network video audio storage optical power sys rfkill \
             input lp scanner kvm docker wireshark uucp)
add_groups=()
for g in "${want_groups[@]}"; do
    getent group "$g" >/dev/null 2>&1 && add_groups+=("$g")
done
if [[ ${#add_groups[@]} -gt 0 ]]; then
    IFS=','; usermod -aG "${add_groups[*]}" "${LIVE_USER}"; unset IFS
fi

# Passwords (live only).
echo "${LIVE_USER}:${LIVE_PASS}" | chpasswd
echo "root:${ROOT_PASS}"        | chpasswd

# Passwordless sudo for the live user (NOT persisted to an installed system,
# because this file is created in the live overlay, not in the SquashFS).
install -d -m 0750 /etc/sudoers.d
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "${LIVE_USER}" > /etc/sudoers.d/99-aegis-live
chmod 0440 /etc/sudoers.d/99-aegis-live

# LightDM autologin for the live session (live overlay only, so the installed
# system does not try to autologin a user that Calamares never created). The
# 'autologin' group membership is granted above via want_groups.
install -d -m 0755 /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/20-aegis-live.conf <<EOF
[Seat:*]
greeter-session=lightdm-gtk-greeter
autologin-user=${LIVE_USER}
autologin-user-timeout=0
autologin-session=xfce
user-session=xfce
EOF

# --- XDG user dirs -----------------------------------------------------------
runuser -u "${LIVE_USER}" -- xdg-user-dirs-update 2>/dev/null || true

# --- Trust the desktop launchers ---------------------------------------------
# XFCE >= 4.16 refuses to run a .desktop file on the desktop unless it is
# executable AND carries a metadata::xfce-exe-checksum matching its contents;
# otherwise the user gets an "Untrusted application launcher" prompt. /etc/skel
# ships mode 0644 (the repo is authored on Windows, so nothing there has an exec
# bit), so grant both here. gio comes from gvfs, already in packages.x86_64.
LIVE_HOME="$(getent passwd "${LIVE_USER}" | cut -d: -f6)"
if [[ -n "${LIVE_HOME}" && -d "${LIVE_HOME}/Desktop" ]]; then
    for launcher in "${LIVE_HOME}"/Desktop/*.desktop; do
        [[ -f "${launcher}" ]] || continue
        chmod +x "${launcher}"
        sum="$(sha256sum "${launcher}" | cut -d' ' -f1)"
        runuser -u "${LIVE_USER}" -- \
            gio set "${launcher}" metadata::xfce-exe-checksum "${sum}" 2>/dev/null || true
    done
    chown -R "${LIVE_USER}:${LIVE_USER}" "${LIVE_HOME}/Desktop" 2>/dev/null || true
fi

# --- VM guest integration (auto-detect) --------------------------------------
# IMPORTANT: use --no-block (fire-and-forget). A plain `systemctl start` waits
# for the unit's job to finish, and some guest agents block indefinitely: e.g.
# qemu-guest-agent.service has BindsTo=/After= the virtio-serial device
# org.qemu.guest_agent.0, so on a VM created without a guest-agent channel it
# waits forever for a device that never appears. Because this script runs in a
# no-timeout oneshot ordered Before=display-manager.service, that would hang the
# entire boot (the classic "A start job is running ... / no limit" freeze).
# These agents are never needed before the display manager, so just enqueue and
# move on.
case "$(systemd-detect-virt 2>/dev/null || echo none)" in
    oracle)     systemctl start --no-block vboxservice.service 2>/dev/null || true ;;
    vmware)     systemctl start --no-block vmtoolsd.service 2>/dev/null || true ;;
    kvm|qemu)   systemctl start --no-block qemu-guest-agent.service spice-vdagentd.service 2>/dev/null || true ;;
    microsoft)  systemctl start --no-block hv_fcopy_daemon.service hv_kvp_daemon.service hv_vss_daemon.service 2>/dev/null || true ;;
esac

echo ":: Aegis OS live setup complete"
exit 0
