#!/usr/bin/env bash
# =============================================================================
#  drop-install-launcher — remove the live-only installer launchers from the
#  installed target, so the user created from it never sees an "Install Aegis
#  OS" icon on the desktop, in the panel, or in the menu's application list.
#
#  Runs inside the Calamares target chroot (shellprocess@deskclean), BEFORE the
#  users module copies /etc/skel to the new user's home. The live medium keeps
#  its own copy of everything — this only touches the installed target.
# =============================================================================
set -u

log(){ printf 'drop-install-launcher: %s\n' "$*" >&2; }

DESKTOP=/etc/skel/Desktop/aegis-install.desktop
APPENTRY=/usr/share/applications/aegis-install.desktop
PLASMA_CONFIG=/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc

rm -f "$DESKTOP" && log "removed $DESKTOP"
rm -f "$APPENTRY" && log "removed $APPENTRY (menu application entry)"

if [[ -f "$PLASMA_CONFIG" ]]; then
    sed -i 's/,applications:aegis-install.desktop//g' "$PLASMA_CONFIG" 2>/dev/null || true
    log "removed installer from Plasma taskbar"
fi

exit 0
