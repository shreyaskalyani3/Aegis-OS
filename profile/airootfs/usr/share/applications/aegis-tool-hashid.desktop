[Desktop Entry]
Type=Application
Version=1.0
Name=hashID
GenericName=Identify hash types, including hashcat modes
Comment=Identify hash types, including hashcat modes
Exec=konsole -p tabtitle="hashID" -e aegis-run --group blackarch-cracker --desc 'Identify hash types, including hashcat modes' hashid
Icon=aegis-cat-passwords
Terminal=false
StartupNotify=false
Categories=X-Aegis-Passwords;
Keywords=security;aegis;hashid;
