[Desktop Entry]
Type=Application
Version=1.0
Name=Hash Identifier
GenericName=Identify the type of a hash
Comment=Identify the type of a hash
Exec=aegis-term --profile Aegis -p tabtitle="Hash Identifier" -e aegis-run --group blackarch-cracker --desc 'Identify the type of a hash' hash-identifier
Icon=aegis-cat-passwords
Terminal=false
StartupNotify=false
Categories=X-Aegis-Passwords;
Keywords=security;aegis;hash-identifier;
