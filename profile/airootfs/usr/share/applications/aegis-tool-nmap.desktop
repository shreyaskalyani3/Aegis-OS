[Desktop Entry]
Type=Application
Version=1.0
Name=Nmap
GenericName=Network, port & service scanner
Comment=Network, port & service scanner
Exec=konsole --profile Aegis -p tabtitle="Nmap" -e aegis-run --group blackarch-recon --desc 'Network, port & service scanner' nmap
