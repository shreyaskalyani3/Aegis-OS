[Desktop Entry]
Type=Application
Version=1.0
Name=dsniff
GenericName=Password and traffic sniffing suite
Comment=Password and traffic sniffing suite
Exec=konsole -p tabtitle="dsniff" -e aegis-run --group blackarch-sniffer --desc 'Password and traffic sniffing suite' dsniff
