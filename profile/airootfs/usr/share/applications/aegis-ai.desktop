[Desktop Entry]
Type=Application
Version=1.0
Name=App Vault
GenericName=AI Agents & Security Vault
Comment=Launch or install an AI coding agent (Claude Code, OpenCode, Aider, Codex)
Exec=konsole --profile Aegis -p tabtitle="App Vault" -e aegis-run --desc 'AI coding agent' aegis-ai
Icon=aegis-ai
Terminal=false
StartupNotify=true
Categories=Development;Utility;X-Aegis-Maintenance;
Keywords=ai;agent;claude;opencode;aider;codex;llm;
