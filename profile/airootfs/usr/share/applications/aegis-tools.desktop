[Desktop Entry]
Type=Application
Version=1.0
Name=Aegis Tools
GenericName=Security Tool Manager
Comment=Browse and install BlackArch security tool groups
Exec=aegis-term --profile Aegis -p tabtitle="Aegis Tools" -e aegis-run --desc 'Security tool manager' aegis-tools
Icon=aegis-tools
Terminal=false
StartupNotify=true
Categories=System;Settings;Security;X-Aegis-Maintenance;
Keywords=tools;blackarch;security;install;arsenal;
