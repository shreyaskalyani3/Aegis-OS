[Desktop Entry]
Type=Application
Version=1.0
Name=strace
GenericName=Trace system calls and signals
Comment=Trace system calls and signals
Exec=konsole -p tabtitle="strace" -e aegis-run --group blackarch-reversing --desc 'Trace system calls and signals' strace
