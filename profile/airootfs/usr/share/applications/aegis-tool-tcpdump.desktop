[Desktop Entry]
Type=Application
Version=1.0
Name=tcpdump
GenericName=Command-line packet capture
Comment=Command-line packet capture
Exec=konsole --profile Aegis -p tabtitle="tcpdump" -e aegis-run --group blackarch-sniffer --desc 'Command-line packet capture' tcpdump
Icon=aegis-cat-sniffing
Terminal=false
StartupNotify=false
Categories=X-Aegis-Sniffing;
Keywords=security;aegis;tcpdump;
