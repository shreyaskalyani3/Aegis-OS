[Desktop Entry]
Type=Application
Version=1.0
Name=Aegis Setup
GenericName=First-run Setup
Comment=Configure AI agents, API keys, and install security tool groups
Exec=aegis-term --profile Aegis -p tabtitle="Aegis Setup" -e bash -lc aegis-setup
Icon=preferences-system
Terminal=false
StartupNotify=true
Categories=System;Settings;X-Aegis-Maintenance;
Keywords=setup;wizard;ai;agent;api;keys;tools;
