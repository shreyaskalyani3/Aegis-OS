# =============================================================================
#  aegis.script — Aegis OS plymouth boot splash animation.
#
#  Layout: black screen, the Aegis shield pulsing gently at centre, and a red
#  progress bar sweeping back and forth beneath it. Written against the core
#  script API only (Sprite/SetOpacity/SetPosition, Math.Cos, window globals),
#  modeled on plymouth's own script example theme. The wordmark is baked into
#  shield.png, so no text or label plugin is needed anywhere in the theme.
# =============================================================================

# --- window -------------------------------------------------------------------
Window.SetBackgroundTopColor(0.039, 0.055, 0.078);    # #0a0e14
Window.SetBackgroundBottomColor(0.039, 0.055, 0.078);

# --- assets -------------------------------------------------------------------
shield.image = Image("shield.png");
shield.width = shield.image.GetWidth();
shield.height = shield.image.GetHeight();
shield.x = Window.GetX() + Window.GetWidth() / 2 - shield.width / 2;
shield.y = Window.GetY() + Window.GetHeight() / 2 - shield.height / 2 - 40;
shield.sprite = Sprite(shield.image);
shield.sprite.SetPosition(shield.x, shield.y, 10);

bar.image = Image("bar.png");          # generated at final size — no scaling
bar.width = bar.image.GetWidth();
bar.height = bar.image.GetHeight();
bar.x = Window.GetX() + Window.GetWidth() / 2 - bar.width / 2;
bar.y = shield.y + shield.height + 36;
bar.sprite = Sprite(bar.image);
bar.sprite.SetPosition(bar.x, bar.y, 10);
bar.t = 0;

# --- per-frame refresh: pulse the shield, sweep the bar ------------------------
# 0.6 Hz sine pulse, floor at 0.55 so the logo never dims to near-invisible;
# the bar sweeps left->right and back on a ~2.5 s cycle.
fun refresh_callback ()
  {
    if (status == "normal")
      {
        shield.t += ((2 * 3.14) / 50) * 0.6;
        min_opacity = 0.55;
        opacity = (Math.Cos(shield.t) + 1) / 2;
        opacity *= 1 - min_opacity;
        opacity += min_opacity;
        shield.sprite.SetOpacity(opacity);

        bar.t += 0.02;                 # no modulo in the script API — fold by hand
        if (bar.t >= 2)
          {
            bar.t = 0;
          }
        tri = bar.t;
        if (tri > 1)
          {
            tri = 2 - tri;
          }
        pos = tri * (Window.GetWidth() - bar.width);
        bar.sprite.SetX(pos);
      }
  }

Plymouth.SetRefreshFunction (refresh_callback);

# --- password dialog (LUKS prompts) --------------------------------------------
# Without this an encrypted install would show no prompt at all. Same shape as
# plymouth's script example: a box + entry field + bullet dots, using the
# dialogue assets below (generated by scripts/dev/gen-boot-images.py).
box.image = Image("box.png");
box.x = Window.GetX() + Window.GetWidth() / 2 - box.image.GetWidth() / 2;
box.y = Window.GetY() + Window.GetHeight() / 2 - box.image.GetHeight() / 2;
box.sprite = Sprite(box.image);
box.sprite.SetPosition(box.x, box.y, 10000);
box.sprite.SetOpacity(0);              # created at load — hidden until prompted

entry.image = Image("entry.png");
entry.x = box.x + box.image.GetWidth() / 2 - entry.image.GetWidth() / 2;
entry.y = box.y + box.image.GetHeight() / 2 - entry.image.GetHeight() / 2;
entry.sprite = Sprite(entry.image);
entry.sprite.SetPosition(entry.x, entry.y, 10001);
entry.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");

fun dialog_opacity(opacity)
  {
    box.sprite.SetOpacity(opacity);
    entry.sprite.SetOpacity(opacity);
    for (index = 0; global.dialog.bullet[index]; index++)
      {
        global.dialog.bullet[index].sprite.SetOpacity(opacity);
      }
  }

fun display_password_callback (prompt, bullets)
  {
    global.status = "password";
    dialog_opacity(1);
    for (index = 0; dialog.bullet[index] || index < bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            global.dialog.bullet[index].sprite = Sprite(bullet.image);
            global.dialog.bullet[index].x = entry.x + index * bullet.image.GetWidth();
            global.dialog.bullet[index].y = entry.y + entry.image.GetHeight() / 2 - bullet.image.GetHeight() / 2;
            global.dialog.bullet[index].z = 10002;
            global.dialog.bullet[index].sprite.SetPosition(global.dialog.bullet[index].x,
                                                           global.dialog.bullet[index].y,
                                                           global.dialog.bullet[index].z);
          }
        if (index < bullets)
          global.dialog.bullet[index].sprite.SetOpacity(1);
        else
          global.dialog.bullet[index].sprite.SetOpacity(0);
      }
  }

fun display_normal_callback ()
  {
    global.status = "normal";
    dialog_opacity(0);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);

status = "normal";
dialog.bullet = NULL;
