# --- Theming / fonts ---------------------------------------------------------
adw-gtk-theme
# Required, not cosmetic: adw-gtk-theme has no xfwm4/ directory and none of the
# six themes xfwm4 ships is dark, so this is the only source of the dark window
# decorations xfwm4.xml asks for. It also covers GTK2, which adw-gtk3 does not.
materia-gtk-theme
papirus-icon-theme
gnome-themes-extra
librsvg
qt5ct
kvantum
ttf-dejavu
ttf-liberation
ttf-jetbrains-mono-nerd
noto-fonts
noto-fonts-emoji
noto-fonts-cjk
terminus-font
ttf-nerd-fonts-symbols
ttf-nerd-fonts-symbols-mono

